# Internal repo files. Tracked in git for history, but never served publicly.
# Netlify deploys the whole repo, so without these rules they are fetchable by URL.
/CLAUDE.md              /404.html   404
/DEPLOY-INSTRUCTIONS.md /404.html   404
/scripts/*              /404.html   404

# Deactivated pages. Files stay in the repo; delete the line to bring one back.
/minneapolis            /404.html   404
/minneapolis/           /404.html   404
/minneapolis/*          /404.html   404

# Nav destinations that are in-page anchors on the homepage. Without these, a link
# someone was sent to jmkay.com/services 404s. 302 rather than 301: /services and
# /about become real pages in the autumn rebuild, and a cached permanent redirect
# would outlive them in people's browsers.
/work        /#work        302
/work/       /#work        302
/services    /#services    302
/services/   /#services    302
/about       /#about       302
/about/      /#about       302
/contact     /#contact     302
/contact/    /#contact     302
